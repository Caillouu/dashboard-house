# npm run dev uses a local SQLite file when configured as below.
# Replace with a libsql:// URL and a server-side token for Vercel.
TURSO_DATABASE_URL=file:dashboard.sqlite
TURSO_AUTH_TOKEN=
# Generate three distinct values using openssl rand -hex 32
SESSION_SECRET=
MEMBER_1_CODE=
MEMBER_2_CODE=
PERSON_1=
PERSON_2=

# Optional Google Calendar integration with read-only OAuth access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
CALENDAR_IDS=

WEATHER_LAT=48.8566
WEATHER_LON=2.3522
WEATHER_CITY=Paris
