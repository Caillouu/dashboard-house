{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["cdg1"],
  "functions": {
    "api/alexa.ts": { "includeFiles": "{server,shared}/**/*.ts" },
    "api/dashboard.ts": { "includeFiles": "{server,shared}/**/*.ts" },
    "api/notifications.ts": { "includeFiles": "{server,shared}/**/*.ts" }
  },
  "schedules": {
    "daily-notifications": {
      "schedule": "0 9 * * *",
      "timezone": "Europe/Paris",
      "path": "/api/notifications",
      "requestMethod": "POST"
    }
  },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
    ] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
